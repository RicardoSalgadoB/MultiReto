# Copia este archivo a .env.local para cambiar algo. Todo es opcional.
# Las variables VITE_* se incrustan al compilar y llegan al navegador: nunca pongas secretos aquí.

# Base de la API. Por defecto "/api" (mismo origen): proxy de Vite en desarrollo y rewrite de
# vercel.json en producción. Si pones una URL absoluta (https://...), el backend debe permitir
# ese origen en su CORS_ORIGINS.
# VITE_API_URL=/api

# Plantilla de teselas del mapa base. Por defecto, OpenStreetMap. Cambiar solo si hay que
# usar otro proveedor (los servidores de OSM no tienen SLA y restringen el tráfico intenso).
# VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Solo desarrollo (no llega al navegador): a dónde reenvía el proxy de Vite las llamadas a /api.
# DEV_API_TARGET=http://127.0.0.1:8000
